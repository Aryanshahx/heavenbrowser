<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/heaven_widget_root"
    android:layout_width="match_parent"
    android:layout_height="52dp"
    android:background="@drawable/heaven_widget_pill_bg"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="12dp"
    android:paddingEnd="8dp">

    <ImageView
        android:id="@+id/heaven_widget_logo"
        android:layout_width="26dp"
        android:layout_height="26dp"
        android:contentDescription="Heaven"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_widget_search_brand" />

    <TextView
        android:id="@+id/heaven_widget_search_text"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:ellipsize="end"
        android:gravity="center_vertical"
        android:maxLines="1"
        android:paddingStart="10dp"
        android:paddingEnd="6dp"
        android:text="Search Google or type URL"
        android:textColor="@color/heaven_widget_hint"
        android:textSize="14.5sp" />

    <ImageView
        android:id="@+id/heaven_widget_mic_btn"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:contentDescription="Voice Search"
        android:padding="7dp"
        android:scaleType="centerInside"
        android:src="@drawable/ic_widget_mic" />

    <ImageView
        android:id="@+id/heaven_widget_camera_btn"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:contentDescription="Camera Search"
        android:padding="7dp"
        android:scaleType="centerInside"
        android:src="@drawable/ic_widget_camera" />
</LinearLayout>
